{
  "name": "linkedin-insights",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:full": "node scripts/dev-full.mjs",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "start:api": "tsx server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint && prettier --check .",
    "format": "prettier --write .",
    "test:unit": "vitest",
    "test": "vitest run",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "oxlint --fix"
    ],
    "*.{js,ts,tsx,css,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@mozilla/readability": "^0.6.0",
    "@tailwindcss/vite": "^4.3.2",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "hono": "^4.13.13",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.10.0",
    "rss-parser": "^3.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.5",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "oxlint": "^1.71.0",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "shell-quote": "^1.11.0",
    "nanoid@3": "^3.3.18",
    "source-map-js": "^1.2.2",
    "undici@7": "^7.29.1",
    "postcss@8": "^8.5.23"
  }
}
