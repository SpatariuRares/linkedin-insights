# Copia in .env e compila. .env non va mai committato.

# Porta del server locale (default 8787) e file del database (default data/app.db)
# API_PORT=8787
# DB_FILE=data/app.db

# Cartella dove hai clonato Rizzo Flow (usata da npm run dev:full)
# git clone https://github.com/Rizzo-AI-Academy/rizzo-flow ~/rizzo-flow
RIZZO_FLOW_DIR=~/rizzo-flow

# Opzioni per "rizzo serve" (default: --size 4b). Con poca memoria: --size 1.7b
# RIZZO_SERVE_ARGS=--size 4b

# Chiave per i profili OpenRouter (Impostazioni → Modelli)
# OPENROUTER_API_KEY=sk-or-...
